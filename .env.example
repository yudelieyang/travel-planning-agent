APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_REASONING_EFFORT=low
AGENT_PLANNER=deterministic
SEMANTIC_AUGMENTATION_MODE=deterministic
SEMANTIC_EXTRACTOR_PROMPT_VERSION=semantic_extractor_v3
PLANNER_PROMPT_VERSION=planner_v1
CANDIDATE_DATA_MODE=mock
