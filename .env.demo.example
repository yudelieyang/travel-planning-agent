APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Primary recruiter demo: deterministic, API-key-free, and offline at runtime.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_REASONING_EFFORT=low
AGENT_PLANNER=deterministic
SEMANTIC_AUGMENTATION_MODE=deterministic
SEMANTIC_EXTRACTOR_PROMPT_VERSION=semantic_extractor_v3
PLANNER_PROMPT_VERSION=planner_v1

CANDIDATE_DATA_MODE=snapshot
CANDIDATE_SNAPSHOT_PATH=data/travel/snapshots/openstreetmap/migration_manifest.json

# Optional compose scaffolding; the deterministic planning demo does not call these services.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_agent
POSTGRES_USER=travel_agent
POSTGRES_PASSWORD=change_me
REDIS_HOST=localhost
REDIS_PORT=6379
CHROMA_PERSIST_DIRECTORY=./chroma_data
